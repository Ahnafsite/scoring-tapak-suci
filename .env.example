# Setup: cp .env.example .env && php artisan key:generate
# Then fill in the per-arena values: APP_URL, DB_*, REVERB_APP_*, REVERB_HOST,
# API_URL and API_KEY. Run `php artisan config:clear` after editing this file.

APP_NAME=TapakSuci
APP_ENV=local
APP_KEY=
# Keep false: the debug error page prints this whole file, APP_KEY and
# database credentials included, to anyone on the tournament LAN.
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=scoring_tapak_suci
DB_USERNAME=root
DB_PASSWORD=

# Never `database` for sessions: the tournament database is swapped between
# days, which would log every judge out at once. `redis` is fine when Redis runs.
# 1440 minutes: long breaks between categories used to expire a whole arena.
SESSION_DRIVER=file
SESSION_LIFETIME=1440
CACHE_STORE=file
# Every event is ShouldBroadcastNow, so nothing is ever pushed onto a queue.
QUEUE_CONNECTION=sync

# Only needed when a driver above is set to `redis`.
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

BROADCAST_CONNECTION=reverb
# Any random strings, e.g. from `openssl rand -hex 16`.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# The address Reverb listens on. The panel starts Reverb with --host=<arena IP>,
# so use that IP there; 127.0.0.1 only works with a plain `reverb:start`.
REVERB_HOST=127.0.0.1
REVERB_SCHEME=http

# VITE_* values are compiled into public/build: run `npm run build` after
# changing any of them, including the panel-managed ones below.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Central scoring server (scoring-pencak-silat) that matches are synced from.
API_URL=http://127.0.0.1:8081/api
API_KEY=

# --- Managed by the operator-scoring panel (rewritten on every Start) ---------
# The values below only matter when the arena runs outside the panel.
# SESSION_COOKIE and REDIS_PREFIX must be unique per arena: cookies are not
# scoped by port, so arenas on one host would overwrite each other's session.
APP_PORT=8000
SERVER_PORT=8000
REVERB_PORT=8080
REVERB_SERVER_PORT=8080
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
SESSION_COOKIE=arena0_session
REDIS_PREFIX=arena0_
